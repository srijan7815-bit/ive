{
  "name": "ive",
  "productName": "IVE",
  "version": "1.0.0",
  "description": "IVE \u2014 a living notch for macOS, Windows and Android. Hold fn (or Ctrl+Alt), drag, think out loud; the AI works while you keep working.",
  "main": "src/main/main.js",
  "author": "IVE",
  "license": "MIT",
  "homepage": "https://srijan7815-bit.github.io/ive/",
  "keywords": [
    "macos",
    "notch",
    "ai",
    "electron",
    "assistant",
    "liquid-glass",
    "windows",
    "android",
    "productivity",
    "automation"
  ],
  "scripts": {
    "start": "electron .",
    "dev": "IVE_DEV=1 electron .",
    "demo": "IVE_DEMO=1 electron .",
    "test": "node test/run.js",
    "test:demo": "node test/demo/smoke.js && node test/demo/interaction.js",
    "icons": "python3 scripts/make-icons.py",
    "build:fn": "bash scripts/build-fn-listener.sh",
    "demo:build": "node scripts/build-demo.mjs",
    "demo:frames": "node scripts/screenshot.mjs",
    "dist": "npm run dist:mac",
    "dist:mac": "npm run build:fn && electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:dir": "npm run build:fn && electron-builder --mac --dir",
    "release:mac": "npm run build:fn && electron-builder --mac --publish always",
    "release:win": "electron-builder --win --publish always",
    "release:android": "cd android && ./gradlew bundleRelease assembleRelease",
    "release": "npm run release:mac"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "sharp": "^0.33.5",
    "gifencoder": "^2.0.1",
    "pngjs": "^7.0.0",
    "playwright": "^1.47.2"
  },
  "build": {
    "appId": "ai.ive.app",
    "productName": "IVE",
    "artifactName": "IVE-${version}-${os}-${arch}.${ext}",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "icon": "build/icon.icns",
      "notarize": false,
      "extendInfo": {
        "LSUIElement": 1,
        "NSAppleEventsUsageDescription": "IVE uses Apple events to let your assistant control apps on this Mac when you ask it to.",
        "NSScreenCaptureUsageDescription": "IVE can capture your screen so the assistant can see it when you ask.",
        "NSMicrophoneUsageDescription": "IVE can listen for voice commands."
      },
      "extraResources": [
        {
          "from": "native/fn-listener/.build",
          "to": "bin",
          "filter": [
            "fn-listener"
          ]
        }
      ]
    },
    "dmg": {
      "icon": "build/icon.icns",
      "iconSize": 100,
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "srijan7815-bit",
      "repo": "ive",
      "releaseType": "draft"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signingHashAlgorithms": [
        "sha256"
      ],
      "publisherName": "IVE",
      "requestedExecutionLevel": "asInvoker",
      "extraResources": [
        {
          "from": "native/win",
          "to": "native",
          "filter": [
            "gesture-hook.ps1"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "IVE",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/srijan7815-bit/ive.git"
  },
  "bugs": {
    "url": "https://github.com/srijan7815-bit/ive/issues"
  }
}
